# Copy to server/.env and fill in. Never commit the filled version.

# --- Database -----------------------------------------------------------------
# Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/chat
MONGODB_URI=

# --- Session ------------------------------------------------------------------
# Any long random string. `openssl rand -hex 32` or equivalent.
SESSION_SECRET=

# --- OAuth --------------------------------------------------------------------
# The callback URL is derived from the Host of the request that starts the flow,
# because passport is configured with a *relative* callbackURL. In dev you browse
# Vite on :5173 and it proxies /auth through, so Google sees :5173 — not :8000.
# Register both; only the one you browse is ever used.
#
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorized redirect URIs: http://localhost:5173/auth/google/callback  (npm run dev)
#                             http://localhost:8000/auth/google/callback  (npm start)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub:  https://github.com/settings/developers
#   GitHub allows exactly one callback URL per app, so use the dev one:
#   Authorization callback URL: http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Origins ------------------------------------------------------------------
# Where to send the browser after a successful sign-in. In dev this is Vite.
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated allowlist enforced on the WebSocket upgrade. Browsers do not
# apply CORS to WS handshakes, so leaving this unset in production means any page
# on the internet can open a socket. Unset is correct for local dev only.
ALLOWED_ORIGINS=

# The server's port. client/vite.config.js proxies to this same number via its
# own SERVER_PORT default, so changing one means changing both — a mismatch
# leaves the dev server proxying to nothing and every request hanging.
PORT=8000

# --- Tests only ---------------------------------------------------------------
# Enables POST /auth/test-login so the suites can sign in without real OAuth.
# The server REFUSES TO BOOT if this is 1 while NODE_ENV=production.
ALLOW_TEST_LOGIN=
TEST_LOGIN_SECRET=
